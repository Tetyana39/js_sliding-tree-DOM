"use strict";
// Знаходимо всі <li>, у яких є вкладений <ul>
var treeItems = document.querySelectorAll(".tree li");
treeItems.forEach(function(li) {
    // Отримуємо текст вузла (без дочірніх <ul>)
    var firstNode = li.firstChild;
    if (firstNode && firstNode.nodeType === Node.TEXT_NODE && firstNode.textContent.trim()) {
        var span = document.createElement("span");
        span.textContent = firstNode.textContent.trim();
        firstNode.replaceWith(span);
    }
});
// Делегування кліку
document.querySelector(".tree").addEventListener("click", function(e) {
    if (e.target.tagName !== "SPAN") return;
     // ігноруємо кліки не по тексту
    var parentLi = e.target.parentElement;
    var nestedUl = parentLi.querySelector("ul");
    if (!nestedUl) return;
     // якщо дочірніх немає — нічого не робимо
    nestedUl.hidden = !nestedUl.hidden; // ховаємо / показуємо
});

